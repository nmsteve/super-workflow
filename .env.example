# Copy this file to .env and fill in values for your own environment.

# Local source files used to build the public workflow copy.
PRIVATE_CLAUDE_FILE="$HOME/.claude/CLAUDE.md"
PRIVATE_AGENTS_FILE="$HOME/.codex/AGENTS.md"
PRIVATE_RULES_FILE="$HOME/.claude/hooks/interaction-rules.md"

# Public output directory inside this repository.
PUBLIC_OUTPUT_DIR="./public"

# Public builds use templates by default. Set this to true only if you have
# configured PRIVATE_TERMS and reviewed the generated output carefully.
USE_PRIVATE_SOURCE=false

# Optional GitHub repository used for publishing.
# Example: git@github.com:your-org/super-workflow.git
PUBLIC_REPO_URL=""
PUBLIC_REPO_BRANCH="main"

# Optional private values to redact from generated public files.
# Use a comma-separated list. Example: "prod-api,staging-db,internal-org"
PRIVATE_TERMS=""

# Optional private sync settings for organizations that use SSH-based sync.
# Keep real hostnames in .env only; do not commit .env.
SOURCE_HOST=""
TARGET_HOSTS=""
EXCLUDED_HOSTS=""
