# Example configuration for publishing a public workflow copy.
# Copy to .env in your own checkout and replace placeholders.

PUBLIC_OUTPUT_DIR="./public"
USE_PRIVATE_SOURCE=false

# Optional: publish destination.
PUBLIC_REPO_URL="git@github.com:YOUR_ORG_OR_USER/super-workflow.git"
PUBLIC_REPO_BRANCH="main"

# Optional: only used if USE_PRIVATE_SOURCE=true.
PRIVATE_CLAUDE_FILE="$HOME/.claude/CLAUDE.md"
PRIVATE_AGENTS_FILE="$HOME/.codex/AGENTS.md"
PRIVATE_RULES_FILE="$HOME/.claude/hooks/interaction-rules.md"
PRIVATE_TERMS="INTERNAL_HOST,PRIVATE_REPO,ACCOUNT_ID"

# Optional: private sync placeholders.
SOURCE_HOST="SOURCE_HOST"
TARGET_HOSTS="HOST_A HOST_B HOST_C"
EXCLUDED_HOSTS="RETIRED_HOST_A RETIRED_HOST_B"
